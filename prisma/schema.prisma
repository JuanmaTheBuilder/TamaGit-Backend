generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Slot {
  HEAD
  BODY
  LEGS
}

model Asset {
  id        Int      @id @default(autoincrement())
  name      String
  kind      String   @default("glb")
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]
  pets  Pet[]
}

model User {
  id                Int             @id @default(autoincrement())
  email             String?         @unique
  name              String?
  avatarUrl         String?
  createdAt         DateTime        @default(now())
  githubAccessToken String?
  githubId          Int?            @unique
  githubUsername    String?
  updatedAt         DateTime        @updatedAt
  isAdmin           Boolean         @default(false)
  isBanned          Boolean         @default(false)
  notifications     Notification[]
  PetHidden         PetHidden[]
  projects          Project[]
  ProjectMember     ProjectMember[]
}

model Project {
  id             Int              @id @default(autoincrement())
  githubRepoId   Int              @unique
  name           String
  fullName       String?
  mainLanguage   String?
  tools          String[]         @default([])
  ownerId        Int
  lastSyncedAt   DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  defaultBranch  String?
  CommitAnalysis CommitAnalysis[]
  pet            Pet?
  owner          User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ProjectMember  ProjectMember[]
}

model Pet {
  id           Int         @id @default(autoincrement())
  name         String
  species      String      @default("egg")
  createdAt    DateTime    @default(now())
  health       Int         @default(100)
  hunger       Int         @default(100)
  imageUrl     String?
  projectId    Int         @unique
  happiness    Int         @default(100)
  lifeBranch   String      @default("main")
  updatedAt    DateTime    @default(now())
  modelAssetId Int?
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  modelAsset   Asset?      @relation(fields: [modelAssetId], references: [id])
  PetHidden    PetHidden[]
  items        PetItem[]
}

model PetItem {
  id        Int      @id @default(autoincrement())
  petId     Int
  itemId    Int
  quantity  Int      @default(1)
  equipped  Boolean  @default(false)
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@unique([petId, itemId])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Item {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?
  price       Int       @default(0)
  category    String?
  slot        Slot?
  assetId     Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  asset       Asset?    @relation(fields: [assetId], references: [id])
  pets        PetItem[]
}

model Food {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  imageUrl      String?
  hungerRestore Int      @default(30)
  price         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  size          String   @default("medium")
}

model CommitAnalysis {
  id        Int       @id @default(autoincrement())
  projectId Int
  sha       String
  message   String
  author    String?
  date      DateTime?
  commitUrl String?
  branch    String?
  score     Int       @default(0)
  findings  Json      @default("[]")
  summary   String?
  createdAt DateTime  @default(now())
  fedAt     DateTime?
  Project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sha])
}

model PetHidden {
  id        Int      @id @default(autoincrement())
  petId     Int
  userId    Int
  createdAt DateTime @default(now())
  Pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([petId, userId])
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  userId    Int
  role      String   @default("member")
  createdAt DateTime @default(now())
  Project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}
