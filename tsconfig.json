{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src/app.js",
    "src/lib/pushTokens.js",
    "src/lib/notificador/**/*.js",
    "src/controllers/notificationController.js",
    "test/**/*.js"
  ]
}
